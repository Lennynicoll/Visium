# =============================================================
# Visium - Variables de entorno para el VPS
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" (contiene credenciales).
# =============================================================

# --- Conexion a SQL Server ---
# Formato: Server=HOST;Database=DB;User Id=USER;Password=PASS;TrustServerCertificate=True;MultipleActiveResultSets=true
# Si SQL Server corre en el mismo VPS:  Server=localhost,1433
# Usa el usuario sa (u otro con permisos) creado en el servidor SQL.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=RegistroVisitantesDb;User Id=sa;Password=CAMBIAME;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- CORS (origins permitidos, separados por ;) ---
# Poner aqui el dominio del frontend publicado. Ej:
#   https://visium.com
#   http://localhost:5173
CORS__Origins=http://localhost:5173;https://misitio.com

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
# Puerto interno que escucha la app (usado por Docker para mapear externo)
ASPNETCORE_URLS=http://+:8080
